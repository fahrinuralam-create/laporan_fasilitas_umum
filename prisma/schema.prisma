generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model aiconfiguration {
  id             String   @id @default("default")
  apiKey         String?  @db.Text
  baseUrl        String   @default("https://integrate.api.nvidia.com/v1") @db.VarChar(512)
  textModel      String   @default("meta/llama-3.2-11b-vision-instruct")
  visionModel    String   @default("meta/llama-3.2-11b-vision-instruct")
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  textProvider   String   @default("nvidia") @db.VarChar(100)
  textBaseUrl    String   @default("https://integrate.api.nvidia.com/v1") @db.VarChar(512)
  textApiKey     String?  @db.Text
  visionProvider String   @default("nvidia") @db.VarChar(100)
  visionBaseUrl  String   @default("https://integrate.api.nvidia.com/v1") @db.VarChar(512)
  visionApiKey   String?  @db.Text
  provider       String   @default("nvidia") @db.VarChar(100)
}

model aiconfigurationhistory {
  id              String   @id @default(cuid())
  textProvider    String   @db.VarChar(100)
  textBaseUrl     String   @db.VarChar(512)
  textModel       String
  textKeyHash     String?  @db.VarChar(128)
  textKeySource   String   @db.VarChar(50)
  visionProvider  String   @db.VarChar(100)
  visionBaseUrl   String   @db.VarChar(512)
  visionModel     String
  visionKeyHash   String?  @db.VarChar(128)
  visionKeySource String   @db.VarChar(50)
  provider        String   @db.VarChar(100)
  baseUrl         String   @db.VarChar(512)
  keyHash         String?  @db.VarChar(128)
  keySource       String   @db.VarChar(50)
  updatedByEmail  String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([createdAt], map: "AIConfigurationHistory_createdAt_idx")
  @@index([isActive], map: "AIConfigurationHistory_isActive_idx")
}

model notification {
  id             String    @id @default(cuid())
  userId         String
  reportId       String
  title          String
  message        String    @db.Text
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  telegramError  String?   @db.Text
  telegramSent   Boolean?  @default(false)
  telegramSentAt DateTime?
  report         report    @relation(fields: [reportId], references: [id], onDelete: Cascade, map: "Notification_reportId_fkey")
  user           user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([reportId], map: "Notification_reportId_idx")
  @@index([userId], map: "Notification_userId_idx")
}

model report {
  id                String             @id @default(cuid())
  reportNumber      String             @unique(map: "Report_reportNumber_key")
  title             String
  description       String             @db.Text
  category          report_category
  priority          report_priority
  status            report_status      @default(DIAJUKAN)
  latitude          Float?
  longitude         Float?
  address           String?            @db.Text
  reporterId        String
  assignedOfficerId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  verifiedAt        DateTime?
  completedAt       DateTime?
  aiAnalyzedAt      DateTime?
  aiCategory        report_aiCategory?
  aiConfidence      Float?
  aiPriority        report_aiPriority?
  aiReason          String?            @db.Text
  aiAutoRejected    Boolean?           @default(false)
  aiDuplicateOfId   String?
  aiDuplicateReason String?            @db.Text
  aiIsDuplicate     Boolean?           @default(false)
  aiRejectionReason String?            @db.Text
  notification      notification[]
  assignedOfficer   user?              @relation("ReportOfficer", fields: [assignedOfficerId], references: [id], map: "Report_assignedOfficerId_fkey")
  reporter          user               @relation("ReportReporter", fields: [reporterId], references: [id], map: "Report_reporterId_fkey")
  reporthistory     reporthistory[]
  reportimage       reportimage[]

  @@index([assignedOfficerId], map: "Report_assignedOfficerId_idx")
  @@index([category], map: "Report_category_idx")
  @@index([reporterId], map: "Report_reporterId_idx")
  @@index([status], map: "Report_status_idx")
}

model reporthistory {
  id        String                  @id @default(cuid())
  reportId  String
  userId    String
  oldStatus reporthistory_oldStatus
  newStatus reporthistory_newStatus
  createdAt DateTime                @default(now())
  notes     String?                 @db.Text
  report    report                  @relation(fields: [reportId], references: [id], onDelete: Cascade, map: "ReportHistory_reportId_fkey")
  user      user                    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ReportHistory_userId_fkey")

  @@index([reportId], map: "ReportHistory_reportId_idx")
  @@index([userId], map: "ReportHistory_userId_idx")
}

model reportimage {
  id                String           @id @default(cuid())
  reportId          String
  imageUrl          String           @db.LongText
  type              reportimage_type
  createdAt         DateTime         @default(now())
  aiDescription     String?          @db.Text
  aiImageAnalyzedAt DateTime?
  aiImageConfidence Float?
  aiIsRelevant      Boolean?
  aiPossibleDamage  String?          @db.Text
  aiSeverity        String?
  aiImageMatchTitle Boolean?
  aiRejectionReason String?          @db.Text
  report            report           @relation(fields: [reportId], references: [id], onDelete: Cascade, map: "ReportImage_reportId_fkey")

  @@index([reportId], map: "ReportImage_reportId_idx")
}

model telegramlinktoken {
  id        String    @id @default(cuid())
  token     String    @unique(map: "TelegramLinkToken_token_key")
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  phone     String?
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TelegramLinkToken_userId_fkey")

  @@index([expiresAt], map: "TelegramLinkToken_expiresAt_idx")
  @@index([phone], map: "TelegramLinkToken_phone_idx")
  @@index([userId], map: "TelegramLinkToken_userId_idx")
}

// Pengajuan penautan Telegram dengan verifikasi admin/petugas.
// Ditambahkan secara additive; tabel telegramlinktoken lama tetap dipertahankan.
model telegramlinkrequest {
  id                      String               @id @default(cuid())
  userId                  String
  phone                   String               @db.VarChar(32)
  phoneNormalized         String               @db.VarChar(32)
  previousPhoneNormalized String?              @db.VarChar(32)
  requestType             String               @default("INITIAL") @db.VarChar(20)
  status                  telegram_link_status @default(PENDING_ADMIN)
  telegramUserId          String?              @db.VarChar(32)
  telegramChatId          String?              @db.VarChar(32)
  telegramUsername        String?              @db.VarChar(191)
  candidateTelegramUserId String?              @db.VarChar(32)
  candidateTelegramChatId String?              @db.VarChar(32)
  candidateUsername       String?              @db.VarChar(191)
  confirmationStartedAt   DateTime?
  tokenHash               String?              @unique(map: "TelegramLinkRequest_tokenHash_key") @db.VarChar(64)
  tokenExpiresAt          DateTime?
  tokenUsedAt             DateTime?
  confirmedAt             DateTime?
  reviewedById            String?
  reviewedAt              DateTime?
  rejectionReason         String?              @db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    user                 @relation("TelegramLinkRequestUser", fields: [userId], references: [id], onDelete: Cascade, map: "TelegramLinkRequest_userId_fkey")
  reviewedBy              user?                @relation("TelegramLinkRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, map: "TelegramLinkRequest_reviewedById_fkey")

  @@index([userId], map: "TelegramLinkRequest_userId_idx")
  @@index([status], map: "TelegramLinkRequest_status_idx")
  @@index([phoneNormalized], map: "TelegramLinkRequest_phoneNormalized_idx")
  @@index([telegramChatId], map: "TelegramLinkRequest_telegramChatId_idx")
  @@index([createdAt], map: "TelegramLinkRequest_createdAt_idx")
  @@index([reviewedById], map: "TelegramLinkRequest_reviewedById_idx")
}

model user {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique(map: "User_email_key")
  password             String?
  role                 user_role             @default(MASYARAKAT)
  phone                String?
  address              String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  telegramChatId       String?               @unique(map: "User_telegramChatId_key")
  telegramEnabled      Boolean               @default(true)
  telegramLinkedAt     DateTime?
  telegramUsername     String?
  phoneNormalized      String?               @unique(map: "User_phoneNormalized_key")
  notification         notification[]
  reportsAssigned      report[]              @relation("ReportOfficer")
  reportsReported      report[]              @relation("ReportReporter")
  reporthistory        reporthistory[]
  telegramlinktoken    telegramlinktoken[]
  telegramLinkRequests telegramlinkrequest[] @relation("TelegramLinkRequestUser")
  telegramLinkReviews  telegramlinkrequest[] @relation("TelegramLinkRequestReviewer")

  @@index([email], map: "User_email_idx")
}

enum reporthistory_oldStatus {
  DIAJUKAN
  DIVERIFIKASI
  DITUGASKAN
  DIPROSES
  SELESAI
  DITOLAK
}

enum reportimage_type {
  BEFORE
  AFTER
}

enum report_category {
  JALAN
  LAMPU_JALAN
  SALURAN_AIR
  JEMBATAN
  FASILITAS_KESEHATAN
  LAINNYA
}

enum reporthistory_newStatus {
  DIAJUKAN
  DIVERIFIKASI
  DITUGASKAN
  DIPROSES
  SELESAI
  DITOLAK
}

enum user_role {
  ADMIN
  PETUGAS
  MASYARAKAT
}

enum telegram_link_status {
  PENDING_ADMIN
  PENDING_TELEGRAM
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum report_priority {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}

enum report_status {
  DIAJUKAN
  DIVERIFIKASI
  DITUGASKAN
  DIPROSES
  SELESAI
  DITOLAK
}

enum report_aiCategory {
  JALAN
  LAMPU_JALAN
  SALURAN_AIR
  JEMBATAN
  FASILITAS_KESEHATAN
  LAINNYA
}

enum report_aiPriority {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}
